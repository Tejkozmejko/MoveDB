<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_gym_membership" model="ir.ui.view">
        <field name="name">res.partner.form.gym.membership</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="centric_gym_core.view_partner_form_gym"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_gym_view_checkins']" position="before">
                <button name="action_gym_view_memberships" type="object" class="oe_stat_button" icon="fa-refresh"
                        groups="sales_team.group_sale_salesman"
                        invisible="is_company or gym_member_state == 'none'">
                    <field name="gym_membership_count" widget="statinfo" string="Memberships"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='gym_member']" position="after">
                <group string="Membership" name="gym_membership" invisible="gym_member_state == 'none'">
                    <field name="gym_membership_status" widget="badge"
                           decoration-success="gym_membership_status == 'active'"
                           decoration-info="gym_membership_status == 'not_started'"
                           decoration-warning="gym_membership_status == 'suspended'"
                           decoration-danger="gym_membership_status in ('expired', 'cancelled', 'no_membership')"/>
                    <field name="gym_membership_end" invisible="not gym_membership_end"/>
                    <field name="gym_membership_id" invisible="not gym_membership_id"
                           groups="sales_team.group_sale_salesman"/>
                    <field name="gym_next_membership_id" invisible="not gym_next_membership_id"
                           groups="sales_team.group_sale_salesman"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="gym_member_view_list_membership" model="ir.ui.view">
        <field name="name">res.partner.list.gym.membership</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="centric_gym_core.gym_member_view_list"/>
        <field name="arch" type="xml">
            <field name="gym_member_state" position="after">
                <field name="gym_membership_status" widget="badge"
                       decoration-success="gym_membership_status == 'active'"
                       decoration-info="gym_membership_status == 'not_started'"
                       decoration-warning="gym_membership_status == 'suspended'"
                       decoration-danger="gym_membership_status in ('expired', 'cancelled', 'no_membership')"/>
                <field name="gym_membership_end" optional="show"/>
            </field>
        </field>
    </record>

    <record id="gym_member_view_kanban_membership" model="ir.ui.view">
        <field name="name">res.partner.kanban.gym.membership</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="centric_gym_core.gym_member_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='gym_member_state'][@widget='badge']" position="after">
                <field name="gym_membership_status" widget="badge"
                       decoration-success="gym_membership_status == 'active'"
                       decoration-info="gym_membership_status == 'not_started'"
                       decoration-warning="gym_membership_status == 'suspended'"
                       decoration-danger="gym_membership_status in ('expired', 'cancelled', 'no_membership')"/>
            </xpath>
        </field>
    </record>

    <record id="gym_member_view_search_membership" model="ir.ui.view">
        <field name="name">res.partner.search.gym.membership</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="centric_gym_core.gym_member_view_search"/>
        <field name="arch" type="xml">
            <filter name="filter_former" position="after">
                <separator/>
                <filter name="filter_membership_active" string="Active Membership"
                        domain="[('gym_membership_status', '=', 'active')]"/>
                <filter name="filter_membership_expired" string="Expired"
                        domain="[('gym_membership_status', 'in', ('expired', 'cancelled'))]"/>
                <filter name="filter_membership_suspended" string="Suspended"
                        domain="[('gym_membership_status', '=', 'suspended')]"/>
                <filter name="filter_membership_none" string="No Membership"
                        domain="[('gym_membership_status', '=', 'no_membership')]"/>
            </filter>
        </field>
    </record>

</odoo>
