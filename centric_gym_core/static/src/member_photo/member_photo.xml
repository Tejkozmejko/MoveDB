<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="centric_gym_core.MemberPhotoWidget">
        <button type="button" class="btn btn-secondary o_gym_photo_btn"
                t-att-disabled="props.readonly"
                t-on-click="openCamera">
            <i class="fa fa-camera me-1"/>Take Photo
        </button>
    </t>

    <t t-name="centric_gym_core.MemberPhotoDialog">
        <Dialog title="title" size="'md'">
            <div class="o_gym_photo_dialog text-center">
                <div t-if="state.error" class="alert alert-warning mb-0" t-out="state.error"/>
                <t t-else="">
                    <video t-ref="video" class="w-100 rounded" playsinline="true" muted="true"/>
                    <p t-if="!state.ready" class="text-muted mt-2 mb-0">Starting the camera...</p>
                    <p t-else="" class="text-muted mt-2 mb-0">Head and shoulders, facing the camera.</p>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="!state.ready" t-on-click="capture">
                    <i class="fa fa-camera me-1"/>Capture
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>

</templates>
