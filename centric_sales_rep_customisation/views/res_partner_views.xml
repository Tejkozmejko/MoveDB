<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_sales_rep_customer_statement" model="ir.ui.view">
        <field name="name">res.partner.form.sales.rep.customer.statement</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="customer_rank" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_centric_send_customer_statement"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-envelope"
                    groups="centric_sales_rep_customisation.group_centric_sales_representative"
                    invisible="customer_rank == 0 and not parent_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Send Statement</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
