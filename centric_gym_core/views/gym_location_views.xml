<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gym_location_view_list" model="ir.ui.view">
        <field name="name">gym.location.list</field>
        <field name="model">gym.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="max_stay_minutes" string="Auto Check-Out (min)"/>
                <field name="capacity"/>
                <field name="tz" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="gym_location_view_form" model="ir.ui.view">
        <field name="name">gym.location.form</field>
        <field name="model">gym.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_members" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="member_count" widget="statinfo" string="Members"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Bugibba"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="tz"/>
                        </group>
                        <group>
                            <label for="max_stay_minutes"/>
                            <div class="o_row">
                                <field name="max_stay_minutes" class="oe_inline"/>
                                <span class="ms-1">minutes after check-in</span>
                            </div>
                            <field name="capacity"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gym_locations" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">gym.location</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first gym location</p>
            <p>Each site has its own automatic check-out time and capacity.</p>
        </field>
    </record>

</odoo>
