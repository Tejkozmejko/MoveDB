<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Next to MainComponentsContainer rather than inside .o_customer_display,
         which other modules (e.g. centric_pos_customer_display) replace. -->
    <t t-name="centric_gym_pos.CustomerDisplay" t-inherit="point_of_sale.CustomerDisplay" t-inherit-mode="extension">
        <xpath expr="//MainComponentsContainer" position="before">
            <GymDisplayOverlay data="order"/>
        </xpath>
    </t>

    <t t-name="centric_gym_pos.GymDisplayOverlay">
        <div t-if="sign" class="o_gym_display_layer o_gym_display_sign d-flex flex-column">
            <t t-if="sign.type === 'sign'">
                <div class="o_gym_display_sign_header text-center p-3 fs-3">
                    <t t-esc="sign.member"/>, please read and sign your membership agreement
                </div>
                <iframe class="flex-grow-1 border-0 bg-white" t-att-src="sign.url" title="Membership agreement"/>
            </t>
            <div t-else="" class="d-flex flex-column align-items-center justify-content-center flex-grow-1 text-center">
                <i class="fa fa-check-circle text-success o_gym_display_icon"/>
                <h1 class="mt-3">Thank you!</h1>
            </div>
        </div>

        <div t-elif="welcome" t-attf-class="o_gym_display_layer o_gym_display_welcome d-flex flex-column align-items-center justify-content-center text-center {{ welcome.allowed or welcome.already_inside ? 'is-ok' : 'is-ko' }}">
            <img t-if="welcome.photo" class="o_gym_display_photo rounded-circle mb-4" t-att-src="photoSrc(welcome)" alt=""/>
            <h1 class="display-4 fw-bold" t-esc="welcome.name"/>
            <h2 class="mt-2">Membership: <t t-esc="welcome.status"/></h2>
            <p class="fs-2 mt-4 mb-0">
                <t t-if="welcome.allowed">Welcome!</t>
                <t t-elif="welcome.already_inside">You are already checked in.</t>
                <t t-else="">Please speak to reception.</t>
            </p>
        </div>

        <t t-elif="idle">
            <button t-if="!state.pinOpen" class="btn btn-primary btn-lg o_gym_display_checkin_btn" t-on-click="openPin">
                <i class="fa fa-sign-in me-2"/>Check in
            </button>
            <div t-else="" class="o_gym_display_layer o_gym_display_pin d-flex flex-column align-items-center justify-content-center">
                <h2 class="mb-3">Type your member PIN</h2>
                <div class="o_gym_display_pin_dots d-flex gap-3 mb-3">
                    <t t-foreach="[0, 1, 2, 3]" t-as="index" t-key="index">
                        <span t-attf-class="o_gym_pin_dot {{ state.pin.length > index ? 'filled' : '' }}"/>
                    </t>
                </div>
                <div class="text-danger fs-5 mb-2" t-if="state.error" t-esc="state.error"/>
                <div class="o_gym_display_keypad">
                    <t t-foreach="keys" t-as="key" t-key="key">
                        <button t-attf-class="btn btn-lg {{ key === 'ok' ? 'btn-primary' : 'btn-light border' }}"
                                t-att-disabled="state.busy" t-on-click="() => this.press(key)">
                            <t t-if="key === 'clear'"><i class="fa fa-times"/></t>
                            <t t-elif="key === 'ok'">OK</t>
                            <t t-else="" t-esc="key"/>
                        </button>
                    </t>
                </div>
                <button class="btn btn-link mt-3 fs-5" t-on-click="closePin">Cancel</button>
            </div>
        </t>
    </t>

</templates>
