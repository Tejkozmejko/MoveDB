<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_gym" model="ir.module.category">
        <field name="name">Gym</field>
        <field name="description">Access levels for the Centric Gym apps.</field>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_gym" model="res.groups.privilege">
        <field name="name">Gym</field>
        <field name="description">Reception runs the desk, managers handle exceptions and reporting, administrators configure the gym.</field>
        <field name="category_id" ref="module_category_gym"/>
        <field name="sequence">10</field>
    </record>

    <!-- Health data is a separate ladder: running the gym does not entitle
         anyone to read members' medical information, so no gym level implies it. -->
    <record id="res_groups_privilege_gym_health" model="res.groups.privilege">
        <field name="name">Gym Health Data</field>
        <field name="description">Can read and edit members' health information.</field>
        <field name="category_id" ref="module_category_gym"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_gym_reception" model="res.groups">
        <field name="name">Reception</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <!-- Reception keeps members' phone, address and emergency details up to
             date, which needs Contacts > Creation; internal users can only read. -->
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>

    <record id="group_gym_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('group_gym_reception'))]"/>
    </record>

    <record id="group_gym_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('group_gym_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_gym_health" model="res.groups">
        <field name="name">Health Data</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_gym_health"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_gym_location_company" model="ir.rule">
        <field name="name">Gym location: own companies</field>
        <field name="model_id" ref="model_gym_location"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
