<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_centric_loadsheet_category_list" model="ir.ui.view">
        <field name="name">centric.loadsheet.category.list</field>
        <field name="model">centric.loadsheet.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_centric_loadsheet_category_form" model="ir.ui.view">
        <field name="name">centric.loadsheet.category.form</field>
        <field name="model">centric.loadsheet.category</field>
        <field name="arch" type="xml">
            <form string="Loadsheet Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_centric_loadsheet_category" model="ir.actions.act_window">
        <field name="name">Loadsheet Categories</field>
        <field name="res_model">centric.loadsheet.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_centric_loadsheet_category"
              name="Loadsheet Categories"
              parent="stock.menu_product_in_config_stock"
              action="action_centric_loadsheet_category"
              sequence="3"
              groups="stock.group_stock_manager"/>
</odoo>
