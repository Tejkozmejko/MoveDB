<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_fsm_rounding" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.centric.fsm.rounding</field>
        <field name="model">res.config.settings</field>
        <!-- Higher than timesheet_grid's priority 2 so this lands directly
             underneath the native Time Rounding box in the same block. -->
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="timesheet_grid.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='time_encoding_setting_container']" position="inside">
                <setting id="centric_fsm_time_rounding"
                         invisible="is_encode_uom_days"
                         string="Field Service Time Rounding"
                         help="Applies instead of the rounding above when the timer runs on a Field Service task. Leave a value at 0 to fall back to the setting above.">
                    <div class="mt16">
                        <div class="o_row">
                            <div class="o_light_label"
                                 title="Timers stopped on a Field Service task below this duration are rounded up to it. For instance, with a minimal duration of 30 min, stopping the timer at 00:04:36 records 00:30.">
                                <label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4"
                                       for="centric_fsm_timesheet_min_duration"/>
                                <field name="centric_fsm_timesheet_min_duration"
                                       class="w-25 text-center" nolabel="1"/>
                                <span class="col-auto ms-2">min</span>
                            </div>
                        </div>
                        <div class="o_row">
                            <div class="o_light_label"
                                 title="Once past the minimal duration, Field Service timers are rounded up to the next multiple of this number. For instance, with a round up of 15 min, stopping the timer at 00:38:12 records 00:45.">
                                <label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4"
                                       for="centric_fsm_timesheet_rounding"/>
                                <field name="centric_fsm_timesheet_rounding"
                                       class="w-25 text-center" nolabel="1"/>
                                <span class="col-auto ms-2">min</span>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
