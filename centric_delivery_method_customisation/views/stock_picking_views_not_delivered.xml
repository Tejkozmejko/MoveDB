<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_not_delivered_flow" model="ir.ui.view">
        <field name="name">stock.picking.form.not.delivered.flow.hidden.fields</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="not_delivered_origin_id" invisible="1"/>
                <field name="not_delivered_replacement_id" invisible="1"/>
                <field name="not_delivered_return_picking_id" invisible="1"/>
                <field name="not_delivered_credit_note_ids" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
