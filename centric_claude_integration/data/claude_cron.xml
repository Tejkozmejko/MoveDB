<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Screenshots are large and stop being interesting quickly, while the
         transcript around them costs almost nothing to keep. So the images are
         pruned on their own schedule and the conversation survives. -->
    <record id="ir_cron_claude_attachment_gc" model="ir.cron">
        <field name="name">Centric Claude: delete old chat images</field>
        <field name="model_id" ref="model_centric_claude_attachment"/>
        <field name="state">code</field>
        <field name="code">model._gc_workspace_attachments()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
