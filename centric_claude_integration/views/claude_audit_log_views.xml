<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_claude_audit_log_list" model="ir.ui.view">
        <field name="name">centric.claude.audit.log.list</field>
        <field name="model">centric.claude.audit.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="repository"/>
                <field name="branch" optional="show"/>
                <field name="module_name" optional="show"/>
                <field name="file_path" optional="hide"/>
                <field name="success"/>
                <field name="commit_sha" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_claude_audit_log_form" model="ir.ui.view">
        <field name="name">centric.claude.audit.log.form</field>
        <field name="model">centric.claude.audit.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="user_id"/>
                            <field name="action"/>
                            <field name="success"/>
                        </group>
                        <group>
                            <field name="repository"/>
                            <field name="branch"/>
                            <field name="module_name"/>
                            <field name="file_path"/>
                            <field name="commit_sha"/>
                        </group>
                    </group>
                    <group>
                        <field name="conversation_id"/>
                        <field name="details"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_claude_audit_log_search" model="ir.ui.view">
        <field name="name">centric.claude.audit.log.search</field>
        <field name="model">centric.claude.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="action"/>
                <field name="repository"/>
                <field name="branch"/>
                <field name="module_name"/>
                <field name="file_path"/>
                <filter name="failed" string="Failed" domain="[('success', '=', False)]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                    <filter name="group_module" string="Module" context="{'group_by': 'module_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_claude_audit_logs" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">centric.claude.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_claude_audit_log_search"/>
    </record>

</odoo>
