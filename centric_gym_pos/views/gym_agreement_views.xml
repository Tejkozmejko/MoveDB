<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gym_agreement_view_form_pos" model="ir.ui.view">
        <field name="name">gym.agreement.form.pos</field>
        <field name="model">gym.agreement</field>
        <field name="inherit_id" ref="centric_gym_sign.gym_agreement_view_form"/>
        <field name="arch" type="xml">
            <field name="create_date" position="before">
                <field name="sale_order_id" invisible="not sale_order_id" groups="sales_team.group_sale_salesman"/>
                <field name="pos_order_id" invisible="not pos_order_id" groups="point_of_sale.group_pos_user"/>
            </field>
        </field>
    </record>

    <record id="gym_agreement_view_list_pos" model="ir.ui.view">
        <field name="name">gym.agreement.list.pos</field>
        <field name="model">gym.agreement</field>
        <field name="inherit_id" ref="centric_gym_sign.gym_agreement_view_list"/>
        <field name="arch" type="xml">
            <field name="version" position="after">
                <field name="sale_order_id" optional="show" groups="sales_team.group_sale_salesman"/>
            </field>
        </field>
    </record>
</odoo>
