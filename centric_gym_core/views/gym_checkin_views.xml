<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gym_checkin_view_list" model="ir.ui.view">
        <field name="name">gym.checkin.list</field>
        <field name="model">gym.checkin</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="result == 'denied'" decoration-warning="result == 'override'"
                  decoration-muted="check_out and result != 'denied'">
                <field name="partner_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="planned_check_out" optional="show"/>
                <field name="checkout_type" optional="show"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'allowed'"
                       decoration-warning="result == 'override'"
                       decoration-danger="result == 'denied'"/>
                <field name="deny_reason" optional="show"/>
                <field name="duration" widget="float_time" optional="hide"/>
                <field name="location_id" optional="show"/>
                <field name="identified_by" optional="hide"/>
                <field name="override_user_id" optional="hide"/>
                <field name="override_reason" optional="hide"/>
                <field name="check_in_user_id" optional="hide"/>
                <field name="is_inside" column_invisible="True"/>
                <button name="gym_check_out" type="object" string="Check Out" icon="fa-sign-out"
                        class="btn-link" invisible="not is_inside"/>
            </list>
        </field>
    </record>

    <!-- Contact tracing: who, how to reach them, and how long they were in. -->
    <record id="gym_checkin_view_list_presence" model="ir.ui.view">
        <field name="name">gym.checkin.list.presence</field>
        <field name="model">gym.checkin</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="partner_id"/>
                <field name="partner_phone" widget="phone"/>
                <field name="partner_email" widget="email" optional="show"/>
                <field name="check_in"/>
                <field name="presence_end"/>
                <field name="checkout_type"/>
                <field name="location_id"/>
                <field name="result"/>
            </list>
        </field>
    </record>

    <record id="gym_checkin_view_form" model="ir.ui.view">
        <field name="name">gym.checkin.form</field>
        <field name="model">gym.checkin</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="gym_check_out" type="object" string="Check Out" class="btn-primary"
                            invisible="not is_inside"/>
                    <field name="result" widget="statusbar" statusbar_visible="allowed,override,denied"/>
                </header>
                <sheet>
                    <field name="is_inside" invisible="1"/>
                    <widget name="web_ribbon" title="Inside" bg_color="text-bg-success" invisible="not is_inside"/>
                    <div class="oe_title">
                        <h1><field name="partner_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Visit">
                            <field name="location_id" readonly="1"/>
                            <field name="check_in" readonly="1"/>
                            <field name="planned_check_out"/>
                            <field name="check_out"/>
                            <field name="checkout_type"/>
                            <field name="presence_end"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                        <group string="Access">
                            <field name="deny_reason" readonly="1" invisible="not deny_reason"/>
                            <field name="membership_end" readonly="1"/>
                            <field name="identified_by" readonly="1"/>
                            <field name="source" readonly="1"/>
                            <field name="override_user_id" invisible="result != 'override'"/>
                            <field name="override_reason" invisible="result != 'override'" readonly="1"/>
                            <field name="check_in_user_id"/>
                            <field name="check_out_user_id" invisible="not check_out_user_id"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gym_checkin_view_search" model="ir.ui.view">
        <field name="name">gym.checkin.search</field>
        <field name="model">gym.checkin</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="location_id"/>
                <filter name="filter_inside" string="Inside Now" domain="[('is_inside', '=', True)]"/>
                <filter name="filter_visits" string="Visits" domain="[('result', '!=', 'denied')]"/>
                <filter name="filter_denied" string="Refused" domain="[('result', '=', 'denied')]"/>
                <filter name="filter_override" string="Overrides" domain="[('result', '=', 'override')]"/>
                <filter name="filter_auto" string="Checked Out Automatically" domain="[('checkout_type', '=', 'auto')]"/>
                <separator/>
                <filter name="filter_today" string="Today"
                        domain="[('check_in', '&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="filter_check_in" string="Check-In" date="check_in"/>
                <group>
                    <filter name="group_partner" string="Member" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_location" string="Location" context="{'group_by': 'location_id'}"/>
                    <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
                    <filter name="group_reason" string="Reason" context="{'group_by': 'deny_reason'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'check_in:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="gym_checkin_view_pivot" model="ir.ui.view">
        <field name="name">gym.checkin.pivot</field>
        <field name="model">gym.checkin</field>
        <field name="arch" type="xml">
            <pivot string="Attendance" sample="1">
                <field name="day_of_week" type="col"/>
                <field name="hour_of_day" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="gym_checkin_view_graph" model="ir.ui.view">
        <field name="name">gym.checkin.graph</field>
        <field name="model">gym.checkin</field>
        <field name="arch" type="xml">
            <graph string="Attendance" type="bar" sample="1">
                <field name="hour_of_day" type="row"/>
            </graph>
        </field>
    </record>

    <record id="action_gym_checkins" model="ir.actions.act_window">
        <field name="name">Check-Ins</field>
        <field name="res_model">gym.checkin</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No check-ins yet</p>
            <p>Members are checked in from Gym → Reception.</p>
        </field>
    </record>

    <record id="action_gym_inside_now" model="ir.actions.act_window">
        <field name="name">Inside Now</field>
        <field name="res_model">gym.checkin</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_inside': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Nobody is inside</p>
        </field>
    </record>

    <record id="action_gym_attendance_analysis" model="ir.actions.act_window">
        <field name="name">Attendance Analysis</field>
        <field name="res_model">gym.checkin</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_filter_visits': 1}</field>
    </record>

    <record id="gym_presence_report_view_form" model="ir.ui.view">
        <field name="name">gym.presence.report.form</field>
        <field name="model">gym.presence.report</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    Everyone checked in at any moment of this period, including members checked out
                    automatically (their exact leaving time is not known).
                </p>
                <group>
                    <field name="location_id" options="{'no_create': True}" placeholder="All locations"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_show" type="object" string="Show" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gym_presence_report" model="ir.actions.act_window">
        <field name="name">Who Was Inside?</field>
        <field name="res_model">gym.presence.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_gym_reception" model="ir.actions.client">
        <field name="name">Reception</field>
        <field name="tag">centric_gym_core.reception</field>
    </record>

</odoo>
