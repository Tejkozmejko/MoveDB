<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Odoo 19: a group is surfaced on the user's Access Rights via a
         res.groups.privilege, which sits under an app category. Use our own
         distinctly-named category so it does NOT create a second "Sales"
         section. Renders as a "Barcode Sales Entry" toggle under its own
         "Centric Sales Tools" heading. -->
    <record id="module_category_centric_sales_tools" model="ir.module.category">
        <field name="name">Centric Sales Tools</field>
        <field name="sequence">100</field>
    </record>

    <record id="res_groups_privilege_centric_barcode_sales_entry" model="res.groups.privilege">
        <field name="name">Barcode Sales Entry</field>
        <field name="category_id" ref="module_category_centric_sales_tools"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_centric_sale_barcode_entry" model="res.groups">
        <field name="name">Enabled</field>
        <field name="privilege_id" ref="res_groups_privilege_centric_barcode_sales_entry"/>
        <field name="comment">Gives a user the "Scan Product" box on the sales order to add products by scanning their barcode.</field>
    </record>
</odoo>
