<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_gym_memberships" model="ir.actions.server">
        <field name="name">Memberships</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">action = model._gym_memberships_action()</field>
    </record>

    <menuitem id="menu_gym_memberships"
              name="Memberships"
              parent="centric_gym_core.menu_gym_root"
              action="action_gym_memberships"
              groups="sales_team.group_sale_salesman"
              sequence="30"/>

    <menuitem id="menu_gym_membership_products"
              name="Membership Products"
              parent="centric_gym_core.menu_gym_configuration"
              action="action_gym_membership_products"
              groups="sales_team.group_sale_manager"
              sequence="25"/>

</odoo>
