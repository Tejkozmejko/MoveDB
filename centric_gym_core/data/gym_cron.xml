<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_gym_release_inactive_pins" model="ir.cron">
        <field name="name">Gym: release PINs of inactive members</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._cron_gym_release_inactive_pins()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:30:00')"/>
    </record>

    <!-- Each check-in also asks for a run at its own check-out time; this
         regular run only catches anything those runs missed. -->
    <record id="cron_gym_auto_check_out" model="ir.cron">
        <field name="name">Gym: automatic check-out</field>
        <field name="model_id" ref="model_gym_checkin"/>
        <field name="state">code</field>
        <field name="code">model._cron_gym_auto_check_out()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="cron_gym_purge_old_checkins" model="ir.cron">
        <field name="name">Gym: delete check-ins past the retention period</field>
        <field name="model_id" ref="model_gym_checkin"/>
        <field name="state">code</field>
        <field name="code">model._cron_gym_purge_old_checkins()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
    </record>
</odoo>
