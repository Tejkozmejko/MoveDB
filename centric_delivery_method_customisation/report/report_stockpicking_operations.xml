<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_picking_operation_sale_line_note" inherit_id="stock.report_picking">
        <!-- The whole picking page is rebuilt as a clean warehouse document.
             It is laid out with CSS display:table DIVs (not <table> tags) on
             purpose: that renders identically in Chrome print and the
             wkhtmltopdf engine, and avoids the Bootstrap/report table borders
             that wkhtmltopdf draws on real <table> elements. Everything is
             scoped under .centric_picking_report so no other report changes. -->
        <xpath expr="//div[hasclass('o_report_layout_standard')]" position="attributes">
            <attribute name="class" add="centric_picking_report" separator=" "/>
        </xpath>

        <xpath expr="//div[hasclass('o_report_layout_standard')]" position="inside">
            <style>
                .centric_picking_report { font-size: 11.5px; color: #1c1c1c; }
                .centric_picking_report .page { padding: 0; }

                /* ---- Header ---- */
                .centric_picking_report .cpk-head { display: table; width: 100%; margin: 0 0 10px; }
                .centric_picking_report .cpk-head-l { display: table-cell; width: 56%; vertical-align: top; }
                .centric_picking_report .cpk-head-r { display: table-cell; width: 44%; vertical-align: top; }
                .centric_picking_report .cpk-doctype {
                    font-size: 11px; font-weight: 700; letter-spacing: .6px;
                    text-transform: uppercase; color: #666; margin: 0 0 1px;
                }
                .centric_picking_report .cpk-ref {
                    font-size: 18px; font-weight: 700; line-height: 1.1; white-space: nowrap;
                }
                .centric_picking_report .cpk-ref-bc { margin-top: 5px; }
                .centric_picking_report .cpk-ref-bc img { height: 38px; width: auto; max-width: 100%; }
                .centric_picking_report .cpk-meta { display: table; width: 100%; }
                .centric_picking_report .cpk-meta-row { display: table-row; }
                .centric_picking_report .cpk-meta-k, .centric_picking_report .cpk-meta-v {
                    display: table-cell; padding: 1px 0; font-size: 11px; vertical-align: top;
                }
                .centric_picking_report .cpk-meta-k {
                    color: #666; font-weight: 700; text-transform: uppercase;
                    letter-spacing: .3px; white-space: nowrap; padding-right: 10px; width: 45%;
                }
                .centric_picking_report .cpk-meta-v { text-align: right; }

                /* ---- Info row ---- */
                .centric_picking_report .cpk-info { display: table; width: 100%; margin: 0 0 12px; }
                .centric_picking_report .cpk-info-row { display: table-row; }
                .centric_picking_report .cpk-info-cell {
                    display: table-cell; width: 33.33%; padding: 7px 12px 7px 0;
                    vertical-align: top; border-top: 1px solid #ddd; border-bottom: 1px solid #ddd;
                }
                .centric_picking_report .cpk-info-cell .k {
                    display: block; font-size: 10px; font-weight: 700;
                    text-transform: uppercase; letter-spacing: .3px; color: #666;
                }
                .centric_picking_report .cpk-info-cell .v { display: block; font-size: 12px; line-height: 1.25; }

                /* ---- Lines ---- */
                .centric_picking_report .cpk-lines { display: table; width: 100%; table-layout: fixed; }
                .centric_picking_report .cpk-lhead { display: table-row; }
                .centric_picking_report .cpk-row { display: table-row; }
                .centric_picking_report .cpk-lhead .cpk-c {
                    border-bottom: 1.5px solid #222; padding: 6px 8px;
                    font-size: 10px; font-weight: 700; text-transform: uppercase;
                    letter-spacing: .3px; color: #333; white-space: nowrap;
                }
                .centric_picking_report .cpk-row .cpk-c {
                    border-bottom: 1px solid #d8d8d8; padding: 8px; vertical-align: top;
                }
                /* Merged rows stack one sub-line + barcode per lot, so they can be
                   tall; keep each row on one page. wkhtmltopdf already moves whole
                   CSS-table rows, but the browser-print path (Chrome) splits them,
                   orphaning lot barcodes from their product/quantity cells. */
                .centric_picking_report .cpk-row { page-break-inside: avoid; break-inside: avoid; }
                .centric_picking_report .cpk-c { display: table-cell; vertical-align: top; text-align: left; }
                .centric_picking_report .cpk-c-prod { width: 46%; }
                .centric_picking_report .cpk-c-qty { width: 14%; }
                .centric_picking_report .cpk-c-route { width: 26%; }
                .centric_picking_report .cpk-c-bc { width: 14%; text-align: center; }
                .centric_picking_report .cpk-pname {
                    font-weight: 600; font-size: 12px; line-height: 1.2; overflow-wrap: break-word;
                }
                .centric_picking_report .cpk-psub {
                    font-size: 10px; color: #555; line-height: 1.3; margin-top: 2px; overflow-wrap: break-word;
                }
                .centric_picking_report .cpk-psub b { color: #333; }
                .centric_picking_report .cpk-qnum { font-weight: 700; font-size: 13px; white-space: nowrap; }
                .centric_picking_report .cpk-quom { font-size: 10.5px; color: #444; white-space: nowrap; }
                .centric_picking_report .cpk-rfrom, .centric_picking_report .cpk-rto {
                    font-size: 11px; white-space: nowrap; line-height: 1.4;
                }
                .centric_picking_report .cpk-rto { color: #333; }
                .centric_picking_report .cpk-c-bc img { max-width: 100%; height: 32px; }
                .centric_picking_report .cpk-bc-lot + .cpk-bc-lot { margin-top: 4px; }
                .centric_picking_report .cpk-note { margin-top: 10px; font-size: 11px; white-space: pre-line; }
            </style>
            <t t-if="docs and report_type == 'html' and docs.env.context.get('centric_picking_auto_print')">
                <span class="centric_pick_pdf_meta" style="display:none;"
                      t-att-data-url="docs.env.context.get('centric_picking_pdf_url') or ''"
                      t-att-data-name="docs.env.context.get('centric_picking_pdf_name') or 'Pick List.pdf'"/>
                <script type="text/javascript">
                    window.addEventListener('load', function () {
                        var triggerPrint = function () {
                            setTimeout(function () { window.print(); }, 150);
                        };
                        var meta = document.querySelector('.centric_pick_pdf_meta');
                        var pdfUrl = meta ? meta.getAttribute('data-url') : '';
                        var pdfName = 'Pick List.pdf';
                        if (meta) {
                            var n = meta.getAttribute('data-name');
                            if (n) { pdfName = n; }
                        }
                        if (pdfUrl) {
                            // Backup: save the same report as a PDF, then print.
                            var a = document.createElement('a');
                            a.href = pdfUrl;
                            a.download = pdfName;
                            a.target = '_blank';
                            a.rel = 'noopener';
                            a.style.display = 'none';
                            document.body.appendChild(a);
                            a.click();
                            setTimeout(function () { document.body.removeChild(a); }, 2000);
                        }
                        triggerPrint();
                    });
                    window.onafterprint = function () {
                        window.close();
                    };
                </script>
            </t>
        </xpath>

        <!-- Rebuild the whole picking page. We re-render the carrier / weight
             that stock_delivery adds and the loadsheet category so nothing is
             lost by the rewrite. -->
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page centric_pick_page">
                <t t-set="format_number" t-value="lambda x: int(x) if x == int(x) else x"/>
                <t t-set="warehouse" t-value="o.picking_type_id.warehouse_id"/>
                <t t-set="cpk_lines" t-value="o.move_ids.filtered(lambda m: (m.quantity or m.product_uom_qty) and any(not ml.is_entire_pack for ml in m.move_line_ids) or (m.quantity or m.product_uom_qty) and not m.move_line_ids)"/>
                <t t-set="picking_has_barcode" t-value="any((ml.lot_id or ml.lot_name or ml.product_id.barcode) for ml in o.move_line_ids.filtered(lambda ml: not ml.is_entire_pack)) or any(m.product_id.barcode for m in cpk_lines if not m.move_line_ids)"/>

                <!-- Header -->
                <div class="cpk-head">
                    <div class="cpk-head-l">
                        <div class="cpk-doctype" t-field="o.picking_type_id.code">Internal Transfer</div>
                        <div class="cpk-ref" t-out="o.name">CTWH/PICK/00056</div>
                        <div class="cpk-ref-bc" t-if="o.name">
                            <span t-field="o.name" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'height:38px;width:auto;'}"/>
                        </div>
                    </div>
                    <div class="cpk-head-r">
                        <div class="cpk-meta">
                            <div class="cpk-meta-row">
                                <div class="cpk-meta-k">Status</div>
                                <div class="cpk-meta-v"><span t-field="o.state">Done</span></div>
                            </div>
                            <div class="cpk-meta-row" t-if="o.state == 'done' and o.date_done">
                                <div class="cpk-meta-k">Done Date</div>
                                <div class="cpk-meta-v"><span t-field="o.date_done" t-options="{'widget': 'date'}">16/06/2026</span></div>
                            </div>
                            <div class="cpk-meta-row" t-elif="o.scheduled_date">
                                <div class="cpk-meta-k">Scheduled</div>
                                <div class="cpk-meta-v"><span t-field="o.scheduled_date" t-options="{'widget': 'date'}">16/06/2026</span></div>
                            </div>
                            <div class="cpk-meta-row" t-if="o.sale_id.commitment_date">
                                <div class="cpk-meta-k">Delivery Date</div>
                                <div class="cpk-meta-v"><span t-field="o.sale_id.commitment_date" t-options="{'widget': 'date'}">16/06/2026</span></div>
                            </div>
                            <div class="cpk-meta-row" t-if="o.centric_loadsheet_category_id">
                                <div class="cpk-meta-k">Loadsheet</div>
                                <div class="cpk-meta-v"><span t-field="o.centric_loadsheet_category_id">Frozen</span></div>
                            </div>
                            <div class="cpk-meta-row" t-if="o.carrier_id">
                                <div class="cpk-meta-k">Carrier</div>
                                <div class="cpk-meta-v"><span t-field="o.carrier_id">Route 1</span></div>
                            </div>
                            <div class="cpk-meta-row" t-if="o.shipping_weight">
                                <div class="cpk-meta-k">Weight</div>
                                <div class="cpk-meta-v">
                                    <span t-field="o.shipping_weight">3.75</span>
                                    <span t-field="o.weight_uom_name">kg</span>
                                </div>
                            </div>
                            <div class="cpk-meta-row" t-if="o.user_id">
                                <div class="cpk-meta-k">Operator</div>
                                <div class="cpk-meta-v"><span t-field="o.user_id">OdooBot</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Info row: Order / Warehouse / Contact -->
                <div class="cpk-info">
                    <div class="cpk-info-row">
                        <div class="cpk-info-cell">
                            <span class="k">Order</span>
                            <span class="v" t-out="o.origin or '-'">S00066</span>
                        </div>
                        <div class="cpk-info-cell">
                            <span class="k">Warehouse</span>
                            <span class="v" t-out="warehouse.partner_id.name or warehouse.name or '-'">C &amp; T Trade Limited</span>
                        </div>
                        <div class="cpk-info-cell">
                            <span class="k">Contact</span>
                            <span class="v" t-out="o.partner_id.name or '-'">test</span>
                        </div>
                    </div>
                </div>

                <!-- Lines -->
                <div class="cpk-lines" t-if="cpk_lines">
                    <div class="cpk-lhead">
                        <div class="cpk-c cpk-c-prod">Product</div>
                        <div class="cpk-c cpk-c-qty">Quantity</div>
                        <div class="cpk-c cpk-c-route">Route</div>
                        <div class="cpk-c cpk-c-bc" t-if="picking_has_barcode">Barcode</div>
                    </div>
                    <t t-foreach="cpk_lines.sorted(key=lambda m: (m.move_line_ids[:1].location_id.complete_name or '', m.move_line_ids[:1].location_dest_id.complete_name or ''))" t-as="move">
                        <t t-set="move_note" t-value="move.centric_operation_note"/>
                        <t t-set="mls" t-value="move.move_line_ids.filtered(lambda ml: not ml.is_entire_pack)"/>
                        <!-- One row per MOVE, matching the transfer's Items popup: a
                             product reserved out of several lots still prints as one
                             line with the full quantity, and the per-lot shares break
                             down in the small sub-lines (and stacked lot barcodes).
                             The total converts each line without intermediate rounding
                             and display-rounds once, exactly how the popup quantity is
                             computed. Entire-pack lines stay excluded as they always
                             were (packages are not used in this warehouse). -->
                        <div class="cpk-row" t-if="mls">
                            <t t-set="cpk_lots" t-value="move._centric_pick_report_lot_summary()"/>
                            <t t-set="cpk_total" t-value="move.product_uom.round(sum(ml.product_uom_id._compute_quantity(ml.quantity, move.product_uom, round=False) for ml in mls))"/>
                            <t t-set="cpk_routes" t-value="list(dict.fromkeys((ml.location_id.display_name, ml.location_dest_id.display_name) for ml in mls.sorted(key=lambda ml: (ml.location_id.complete_name or '', ml.location_dest_id.complete_name or ''))))"/>
                            <div class="cpk-c cpk-c-prod">
                                <div class="cpk-pname" t-field="move.product_id.display_name">Product name</div>
                                <div class="cpk-psub" t-foreach="cpk_lots" t-as="lot_entry">
                                    <t t-if="lot_entry['name']">
                                        <b>Lot:</b>
                                        <span t-out="lot_entry['name']">6084</span>
                                    </t>
                                    <t t-else="">
                                        <b>No lot</b>
                                    </t>
                                    <t t-if="len(cpk_lots) &gt; 1">
                                        <b> · Qty:</b>
                                        <span t-out="format_number(lot_entry['quantity'])">4</span>
                                    </t>
                                    <t t-if="lot_entry['expiration_date']">
                                        <b> · Expiry:</b>
                                        <span t-out="lot_entry['expiration_date']" t-options="{'widget': 'date'}">02/09/2027</span>
                                    </t>
                                </div>
                                <div class="cpk-psub" t-if="move_note">
                                    <span t-out="move_note" t-options="{'widget': 'text'}">Note</span>
                                </div>
                            </div>
                            <div class="cpk-c cpk-c-qty">
                                <div class="cpk-qnum" t-out="format_number(cpk_total)">15</div>
                                <div class="cpk-quom" t-field="move.product_uom">Packet 250grms</div>
                            </div>
                            <div class="cpk-c cpk-c-route">
                                <t t-foreach="cpk_routes" t-as="cpk_route">
                                    <div class="cpk-rfrom" t-out="cpk_route[0]">CTWH/Stock</div>
                                    <div class="cpk-rto">&#8594; <span t-out="cpk_route[1]">CTWH/Packing Zone</span></div>
                                </t>
                            </div>
                            <div class="cpk-c cpk-c-bc" t-if="picking_has_barcode">
                                <t t-foreach="cpk_lots" t-as="lot_entry">
                                    <div class="cpk-bc-lot" t-if="lot_entry['lot']">
                                        <span t-out="lot_entry['name']" t-options="{'widget': 'barcode', 'humanreadable': 1, 'symbology': 'auto', 'width': 400, 'height': 100, 'quiet': 0, 'img_style': 'height:30px;width:auto;max-width:100%;'}">6084</span>
                                    </div>
                                </t>
                                <!-- Product barcode whenever some quantity has no lot
                                     record to scan: untracked products, manual lot
                                     names, or a lot-less remainder entry. -->
                                <div class="cpk-bc-lot" t-if="(not cpk_lots or any(not lot_entry['lot'] for lot_entry in cpk_lots)) and move.product_id.barcode">
                                    <span t-field="move.product_id.barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 400, 'height': 100, 'quiet': 0, 'img_style': 'height:30px;width:auto;max-width:100%;'}">123456789</span>
                                </div>
                            </div>
                        </div>
                        <div class="cpk-row" t-if="not mls">
                            <div class="cpk-c cpk-c-prod">
                                <div class="cpk-pname" t-field="move.product_id.display_name">Product name</div>
                                <div class="cpk-psub" t-if="move_note">
                                    <span t-out="move_note" t-options="{'widget': 'text'}">Note</span>
                                </div>
                            </div>
                            <div class="cpk-c cpk-c-qty">
                                <div class="cpk-qnum" t-out="format_number(move.quantity or move.product_uom_qty)">15</div>
                                <div class="cpk-quom" t-field="move.product_uom">Packet 250grms</div>
                            </div>
                            <div class="cpk-c cpk-c-route">
                                <div class="cpk-rfrom" t-field="move.location_id.display_name">CTWH/Stock</div>
                                <div class="cpk-rto">&#8594; <span t-field="move.location_dest_id.display_name">CTWH/Packing Zone</span></div>
                            </div>
                            <div class="cpk-c cpk-c-bc" t-if="picking_has_barcode">
                                <t t-if="move.product_id.barcode">
                                    <span t-field="move.product_id.barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 400, 'height': 100, 'quiet': 0, 'img_style': 'height:30px;width:auto;max-width:100%;'}">123456789</span>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="cpk-note" t-if="o.note" t-field="o.note">Notes</div>
            </div>
        </xpath>
    </template>
</odoo>
