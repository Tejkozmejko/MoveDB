<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ================================================================
         Imports
         ================================================================ -->
    <record id="view_stock_email_import_kanban" model="ir.ui.view">
        <field name="name">stock.email.import.kanban</field>
        <field name="model">stock.email.import</field>
        <field name="arch" type="xml">
            <kanban class="o_sei_view" highlight_color="color" sample="1" default_order="id desc">
                <field name="color"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start gap-2">
                            <div class="flex-grow-1 overflow-hidden">
                                <field name="name" class="fw-bold fs-5 text-truncate d-block"/>
                                <div class="text-muted small text-truncate">
                                    <i class="fa fa-envelope-o me-1" title="Sender"/>
                                    <field name="email_from"/>
                                    <span t-if="!record.email_from.raw_value">Uploaded manually</span>
                                </div>
                            </div>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'done'"
                                   decoration-info="state == 'pending'"
                                   decoration-danger="state in ('failed', 'rejected')"
                                   decoration-muted="state == 'draft'"/>
                        </div>
                        <div class="row g-0 text-center mt-3 mb-1 border rounded-3 py-2">
                            <div class="col-4">
                                <div class="fs-4 fw-bold lh-1"><field name="line_count"/></div>
                                <div class="text-muted small text-uppercase">Rows</div>
                            </div>
                            <div class="col-4 border-start border-end">
                                <div class="fs-4 fw-bold lh-1"><field name="changed_count"/></div>
                                <div class="text-muted small text-uppercase">Changes</div>
                            </div>
                            <div class="col-4">
                                <div class="fs-4 fw-bold lh-1"
                                     t-att-class="record.error_count.raw_value ? 'text-danger' : ''">
                                    <field name="error_count"/>
                                </div>
                                <div class="text-muted small text-uppercase">Errors</div>
                            </div>
                        </div>
                        <footer class="pt-2">
                            <span class="text-muted small">
                                <i class="fa fa-clock-o me-1" title="Received"/>
                                <field name="received_date" widget="datetime"/>
                            </span>
                            <span class="ms-auto fw-bold"
                                  t-att-class="record.value_change.raw_value &lt; 0 ? 'text-danger' : (record.value_change.raw_value &gt; 0 ? 'text-success' : 'text-muted')">
                                <field name="value_change" widget="monetary"/>
                            </span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_stock_email_import_list" model="ir.ui.view">
        <field name="name">stock.email.import.list</field>
        <field name="model">stock.email.import</field>
        <field name="arch" type="xml">
            <list class="o_sei_view" decoration-danger="state in ('failed', 'rejected')"
                  decoration-muted="state == 'draft'"
                  sample="1">
                <field name="received_date" string="Received"/>
                <field name="name"/>
                <field name="email_from"/>
                <field name="file_name" optional="show"/>
                <field name="line_count" sum="Rows" optional="show"/>
                <field name="changed_count" sum="Changes"/>
                <field name="error_count" sum="Errors" optional="show"
                       decoration-danger="error_count &gt; 0"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="value_change" sum="Total" widget="monetary"
                       decoration-danger="value_change &lt; 0"
                       decoration-success="value_change &gt; 0"/>
                <field name="applied_date" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'pending'"
                       decoration-danger="state in ('failed', 'rejected')"/>
            </list>
        </field>
    </record>

    <record id="view_stock_email_import_form" model="ir.ui.view">
        <field name="name">stock.email.import.form</field>
        <field name="model">stock.email.import</field>
        <field name="arch" type="xml">
            <form string="Stock Email Import" class="o_sei_view">
                <header>
                    <button name="action_process" type="object" string="Apply Stocktake"
                            class="btn-primary" icon="fa-check" groups="stock.group_stock_manager"
                            invisible="state not in ('draft', 'pending', 'failed')"
                            confirm="Apply the counted quantities of this sheet to inventory?"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            groups="stock.group_stock_manager"
                            invisible="state not in ('failed', 'rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,done"/>
                </header>

                <div class="alert alert-info mb-0 d-flex align-items-center gap-2" role="status"
                     invisible="state != 'pending'">
                    <i class="fa fa-hourglass-half fa-fw" title="Waiting"/>
                    <span><strong>Waiting to be applied.</strong>
                        Emailed sheets are applied automatically within a few minutes -
                        or click <em>Apply Stocktake</em> to do it now.</span>
                </div>
                <div class="alert alert-success mb-0 d-flex align-items-center gap-2" role="status"
                     invisible="state != 'done'">
                    <i class="fa fa-check-circle fa-fw" title="Applied"/>
                    <span><strong>Stock updated.</strong>
                        <field name="changed_count" class="d-inline fw-bold"/> quantity change(s), estimated value change
                        <field name="value_change" widget="monetary" class="d-inline fw-bold"/>.</span>
                </div>
                <div class="alert alert-danger mb-0 d-flex align-items-start gap-2" role="alert"
                     invisible="state != 'failed'">
                    <i class="fa fa-exclamation-triangle fa-fw mt-1" title="Failed"/>
                    <div>
                        <strong>Not applied - no stock was changed.</strong>
                        <field name="error_message" class="d-block"/>
                    </div>
                </div>
                <div class="alert alert-warning mb-0 d-flex align-items-start gap-2" role="alert"
                     invisible="state != 'rejected'">
                    <i class="fa fa-ban fa-fw mt-1" title="Rejected"/>
                    <div>
                        <strong>Rejected - the sender is not allowed.</strong>
                        <field name="error_message" class="d-block"/>
                    </div>
                </div>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object" icon="fa-list-ol"
                                class="oe_stat_button" invisible="not line_count">
                            <field name="line_count" widget="statinfo" string="Rows"/>
                        </button>
                        <button name="action_view_lines" type="object" icon="fa-exchange"
                                class="oe_stat_button" context="{'line_filter': 'filter_changed'}"
                                invisible="not changed_count">
                            <field name="changed_count" widget="statinfo" string="Changes"/>
                        </button>
                        <button name="action_view_lines" type="object" icon="fa-exclamation-circle"
                                class="oe_stat_button text-danger" context="{'line_filter': 'filter_error'}"
                                invisible="not error_count">
                            <field name="error_count" widget="statinfo" string="Errors"/>
                        </button>
                        <button name="action_view_moves" type="object" icon="fa-truck"
                                class="oe_stat_button" invisible="not move_count">
                            <field name="move_count" widget="statinfo" string="Stock Moves"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Applied" bg_color="text-bg-success" invisible="state != 'done'"/>
                    <widget name="web_ribbon" title="Failed" bg_color="text-bg-danger" invisible="state != 'failed'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-warning" invisible="state != 'rejected'"/>

                    <div class="oe_title">
                        <label for="name" string="Stocktake"/>
                        <h1><field name="name" readonly="state == 'done'" placeholder="e.g. Stocktake 14/09"/></h1>
                        <div class="text-muted" invisible="not email_from">
                            <i class="fa fa-envelope-o me-1" title="Sender"/>
                            <field name="email_from" class="d-inline"/>
                        </div>
                    </div>

                    <group>
                        <group string="Sheet">
                            <field name="config_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="file" filename="file_name"
                                   readonly="state not in ('draft', 'failed')"/>
                            <field name="file_name" invisible="1"/>
                            <field name="allow_duplicate" readonly="state == 'done'"
                                   widget="boolean_toggle"/>
                        </group>
                        <group string="Result">
                            <field name="received_date"/>
                            <field name="applied_date" invisible="not applied_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="value_change" widget="monetary"
                                   decoration-danger="value_change &lt; 0"
                                   decoration-success="value_change &gt; 0"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="move_count" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Rows" name="rows">
                            <field name="line_ids" readonly="1" nolabel="1">
                                <list decoration-danger="status == 'error'"
                                      decoration-muted="status == 'skipped'">
                                    <field name="row_number" string="#" width="40px"/>
                                    <field name="status" widget="badge" width="80px"
                                           decoration-danger="status == 'error'"
                                           decoration-success="status == 'ok'"/>
                                    <field name="product_code" optional="hide"/>
                                    <field name="barcode" optional="hide"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="product_name" optional="hide"/>
                                    <field name="location_id" optional="show"/>
                                    <field name="lot_id" optional="show"/>
                                    <field name="previous_qty"/>
                                    <field name="counted_qty" class="fw-bold"/>
                                    <field name="difference_qty"
                                           decoration-danger="difference_qty &lt; 0"
                                           decoration-success="difference_qty &gt; 0"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="value_change" sum="Total" optional="show"/>
                                    <field name="message" class="text-wrap" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_stock_email_import_graph" model="ir.ui.view">
        <field name="name">stock.email.import.graph</field>
        <field name="model">stock.email.import</field>
        <field name="arch" type="xml">
            <graph string="Stock Value Change" type="bar" sample="1">
                <field name="received_date" interval="day"/>
                <field name="value_change" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_stock_email_import_pivot" model="ir.ui.view">
        <field name="name">stock.email.import.pivot</field>
        <field name="model">stock.email.import</field>
        <field name="arch" type="xml">
            <pivot string="Stocktakes" sample="1">
                <field name="received_date" interval="month" type="row"/>
                <field name="state" type="col"/>
                <field name="changed_count" type="measure"/>
                <field name="value_change" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_stock_email_import_search" model="ir.ui.view">
        <field name="name">stock.email.import.search</field>
        <field name="model">stock.email.import</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email_from"/>
                <field name="file_name"/>
                <field name="config_id"/>
                <filter name="filter_attention" string="Needs Attention"
                        domain="[('state', 'in', ('failed', 'rejected'))]"/>
                <filter name="filter_pending" string="Waiting" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_done" string="Applied" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="filter_with_changes" string="With Changes" domain="[('changed_count', '&gt;', 0)]"/>
                <separator/>
                <filter name="filter_received" string="Received" date="received_date"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_sender" string="Sender" context="{'group_by': 'email_from'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'received_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_email_import" model="ir.actions.act_window">
        <field name="name">Stocktake Imports</field>
        <field name="res_model">stock.email.import</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_stock_email_import_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stocktake received yet</p>
            <p>Email an Excel stocktake to the address shown under
               <strong>Stock Email Import &gt; Configuration</strong>.
               Each sheet appears here and is applied to inventory automatically.</p>
        </field>
    </record>

    <!-- ================================================================
         Rows
         ================================================================ -->
    <record id="view_stock_email_import_line_list" model="ir.ui.view">
        <field name="name">stock.email.import.line.list</field>
        <field name="model">stock.email.import.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="status == 'error'"
                  decoration-muted="status == 'skipped'">
                <field name="import_id" optional="hide"/>
                <field name="row_number" string="#"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'error'"
                       decoration-success="status == 'ok'"/>
                <field name="product_code" optional="show"/>
                <field name="product_id"/>
                <field name="location_id" optional="show"/>
                <field name="lot_id" optional="show"/>
                <field name="previous_qty" sum="Before"/>
                <field name="counted_qty" sum="Counted" class="fw-bold"/>
                <field name="difference_qty" sum="Difference"
                       decoration-danger="difference_qty &lt; 0"
                       decoration-success="difference_qty &gt; 0"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="value_change" sum="Total"/>
                <field name="message" class="text-wrap"/>
            </list>
        </field>
    </record>

    <record id="view_stock_email_import_line_search" model="ir.ui.view">
        <field name="name">stock.email.import.line.search</field>
        <field name="model">stock.email.import.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="product_code"/>
                <field name="location_id"/>
                <field name="lot_id"/>
                <filter name="filter_error" string="Errors" domain="[('status', '=', 'error')]"/>
                <filter name="filter_changed" string="Changed" domain="[('difference_qty', '!=', 0)]"/>
                <filter name="filter_skipped" string="Skipped" domain="[('status', '=', 'skipped')]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_location" string="Location" context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
