<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_hide_process_transfers" model="ir.ui.view">
        <field name="name">res.config.settings.hide.process.transfers.centric</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='process_transfers']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//setting[@id='process_transfers']" position="after">
                <setting id="centric_drivers_department" string="Drivers Department"
                         help="Only employees in this department are offered as Drivers on orders, deliveries and payment collection.">
                    <field name="centric_driver_department_id" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
