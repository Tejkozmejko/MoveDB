<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_picking_quantity_wizard_form" model="ir.ui.view">
        <field name="name">centric.stock.picking.quantity.wizard.form</field>
        <field name="model">centric.stock.picking.quantity.wizard</field>
        <field name="arch" type="xml">
            <form string="Items">
                <sheet>
                    <field name="picking_id" invisible="1"/>
                    <field name="line_ids" nolabel="1">
                        <list string="Items" create="false" delete="false" editable="bottom" decoration-success="verified">
                            <field name="show_details_visible" column_invisible="True"/>
                            <field name="move_id" column_invisible="True"/>
                            <field name="verified" column_invisible="True"/>
                            <field name="product_id" readonly="1"/>
                            <field name="centric_loadsheet_category_id" string="Loadsheet Category" readonly="1" optional="hide"/>
                            <field name="product_uom_qty" string="Demand" readonly="1"/>
                            <!-- centric_required_quantity EXTENDS the standard float field
                                 (reliable editable-list click-to-type - not the old always-input
                                 centric_quantity_input, which fought core's edit-mode here). It
                                 only changes the display: a not-yet-entered line shows BLANK
                                 instead of 0.00, so the operator is forced to type a quantity
                                 (0 included). Enforcement is server-side: action_save_quantities
                                 rejects any still-blank line on Save (core skips required
                                 validation for float fields in the browser). See
                                 required_quantity_field.js and _centric_initial_line_quantity. -->
                            <field name="centric_quantity_locked" column_invisible="True"/>
                            <field name="quantity" string="Quantity" widget="centric_required_quantity" readonly="state in ('done', 'cancel') or centric_quantity_locked"/>
                            <field name="product_uom" string="Unit" readonly="1"/>
                            <field name="centric_currency_id" column_invisible="True"/>
                            <field name="centric_unit_price" string="Unit Price" widget="monetary" readonly="1" optional="show"/>
<!-- Opens Detailed Operations as a STACKED dialog (FormViewDialog) so
                                 closing it (Save / Discard / X) returns to this Items popup
                                 instead of tearing down the whole dialog stack to the list and
                                 losing the entered quantities. A plain button here returns an
                                 act_window (target: new) that REPLACES this popup - see
                                 static/src/js/lots_serials_button.js. -->
                            <widget name="centric_lots_serials_button"
                                    groups="stock.group_production_lot"
                                    invisible="not show_details_visible"/>
                            <field name="centric_operation_note" string="Item Note" readonly="1" optional="show"/>
                            <field name="centric_sale_order_note" string="Order Note" readonly="1" optional="show"/>
                            <field name="state" string="Status" widget="badge" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_save_quantities"
                            type="object"
                            string="Save"
                            class="btn-primary o_centric_quantity_save_button"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
