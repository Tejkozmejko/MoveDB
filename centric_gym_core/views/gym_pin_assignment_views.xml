<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gym_pin_assignment_view_list" model="ir.ui.view">
        <field name="name">gym.pin.assignment.list</field>
        <field name="model">gym.pin.assignment</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="not is_current">
                <field name="pin"/>
                <field name="partner_id"/>
                <field name="date_assigned"/>
                <field name="date_released"/>
                <field name="is_current" widget="boolean" optional="show"/>
                <field name="source" optional="show"/>
                <field name="release_reason" optional="show"/>
                <field name="released_by_id" optional="hide"/>
                <field name="card_no" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="gym_pin_assignment_view_search" model="ir.ui.view">
        <field name="name">gym.pin.assignment.search</field>
        <field name="model">gym.pin.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="pin"/>
                <field name="partner_id"/>
                <filter name="filter_current" string="Current" domain="[('is_current', '=', True)]"/>
                <filter name="filter_released" string="Released" domain="[('is_current', '=', False)]"/>
                <separator/>
                <filter name="filter_date_released" string="Released On" date="date_released"/>
                <group>
                    <filter name="group_pin" string="PIN" context="{'group_by': 'pin'}"/>
                    <filter name="group_release_reason" string="Release Reason" context="{'group_by': 'release_reason'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gym_pin_assignments" model="ir.actions.act_window">
        <field name="name">PIN History</field>
        <field name="res_model">gym.pin.assignment</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No PIN has been handed out yet</p>
            <p>Every member PIN ever assigned, and to whom, is listed here.</p>
        </field>
    </record>

</odoo>
