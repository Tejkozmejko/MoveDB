<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sequence_gym_agreement" model="ir.sequence">
        <field name="name">Gym Agreement</field>
        <field name="code">gym.agreement</field>
        <field name="prefix">AGR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Screens waiting on a signature process it at once; this catches
         documents signed later from the emailed link. -->
    <record id="cron_gym_process_signed_agreements" model="ir.cron">
        <field name="name">Gym: process signed agreements</field>
        <field name="model_id" ref="model_gym_agreement"/>
        <field name="state">code</field>
        <field name="code">model._cron_gym_process_signed()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
