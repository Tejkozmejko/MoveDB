<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_gym_pos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.centric.gym.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="gym_location_setting" string="Gym Location"
                         help="Members who type their PIN on this Point of Sale's customer screen are checked in at this gym.">
                    <field name="pos_gym_location_id" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
