<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_claude_turn_list" model="ir.ui.view">
        <field name="name">centric.claude.turn.list</field>
        <field name="model">centric.claude.turn</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="create_date" string="Queued"/>
                <field name="user_id"/>
                <field name="conversation_id"/>
                <field name="state" widget="badge"
                       decoration-warning="state in ('pending','running')"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"/>
                <field name="agent_name"/>
                <field name="developer_mode" optional="show"/>
                <field name="changed_file_count" string="Files" optional="show"/>
                <field name="finished_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_claude_turn_form" model="ir.ui.view">
        <field name="name">centric.claude.turn.form</field>
        <field name="model">centric.claude.turn</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="conversation_id"/>
                            <field name="user_id"/>
                            <field name="state"/>
                            <field name="developer_mode"/>
                        </group>
                        <group>
                            <field name="agent_name"/>
                            <field name="base_branch"/>
                            <field name="claimed_at"/>
                            <field name="finished_at"/>
                        </group>
                    </group>
                    <group string="Prompt">
                        <field name="prompt" nolabel="1"/>
                    </group>
                    <group string="Reply">
                        <field name="assistant_text" nolabel="1"/>
                    </group>
                    <group string="Error" invisible="not error">
                        <field name="error" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_claude_turns" model="ir.actions.act_window">
        <field name="name">Agent Queue</field>
        <field name="res_model">centric.claude.turn</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
