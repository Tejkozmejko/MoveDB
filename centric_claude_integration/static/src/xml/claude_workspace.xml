<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="centric_claude_integration.ClaudeDeveloperWorkspace">
        <div class="o_centric_claude_workspace h-100 d-flex flex-column">

            <!-- title bar -->
            <div class="o_cc_titlebar d-flex align-items-center gap-3 px-3">
                <span class="o_cc_titlebar_brand">
                    <i class="fa fa-cube me-2"/>Claude Developer
                </span>
                <span class="o_cc_chip" t-if="state.access.repository">
                    <i class="fa fa-github"/><t t-esc="state.access.repository"/>
                </span>
                <span class="o_cc_chip" t-if="state.conversation">
                    <i class="fa fa-code-fork"/><t t-esc="activeBranch"/>
                </span>
                <span class="o_cc_chip o_cc_chip_live" t-if="state.agent.backend === 'agent'">
                    <i class="fa fa-desktop"/>Local agent
                </span>
                <span class="o_cc_chip" t-if="state.access.can_read_data"
                      t-att-title="'Claude can use Odoo records at this level'">
                    <i class="fa fa-database"/><t t-esc="state.access.data_level_label"/>
                </span>

                <div class="ms-auto d-flex align-items-center gap-2" t-if="state.conversation">
                    <select class="o_cc_effort"
                            t-ref="effortSelect"
                            title="How hard Claude works on this conversation. Lower levels answer simple questions with less of your Claude subscription."
                            t-att-disabled="state.busy"
                            t-on-change="setEffort">
                        <t t-foreach="effortChoices" t-as="choice" t-key="choice.value">
                            <option t-att-value="choice.value" t-esc="choice.label"/>
                        </t>
                    </select>
                    <span t-if="!state.access.can_develop" class="o_cc_chip o_cc_chip_off">
                        <i class="fa fa-eye"/>Read only
                    </span>
                    <span class="small">Developer Mode</span>
                    <div class="form-check form-switch m-0">
                        <input class="form-check-input"
                               type="checkbox"
                               t-ref="developerModeToggle"
                               t-att-checked="state.conversation.developer_mode"
                               t-att-disabled="!state.access.can_develop"
                               t-on-change="toggleDeveloperMode"/>
                    </div>
                </div>
            </div>

            <!-- gate states -->
            <div t-if="state.loading" class="flex-grow-1 d-flex align-items-center justify-content-center">
                <div class="o_cc_hint"><i class="fa fa-spinner fa-spin me-2"/>Loading workspace...</div>
            </div>

            <div t-elif="!state.access.enabled" class="flex-grow-1 d-flex align-items-center justify-content-center p-4">
                <div class="alert alert-warning mb-0">
                    Claude is not enabled. A Centric Claude Administrator must configure it in Odoo Settings.
                </div>
            </div>

            <!-- workbench -->
            <div t-else="" class="flex-grow-1 d-flex overflow-hidden">

                <!-- activity bar -->
                <nav class="o_cc_activitybar d-flex flex-column">
                    <button class="o_cc_activity" title="Chat"
                            t-att-class="{'active': state.view === 'chat'}"
                            t-on-click="() => this.setView('chat')">
                        <i class="fa fa-comments-o"/>
                    </button>
                    <button class="o_cc_activity" title="Explorer"
                            t-att-class="{'active': state.view === 'explorer'}"
                            t-att-disabled="!state.access.can_read_code"
                            t-on-click="() => this.setView('explorer')">
                        <i class="fa fa-files-o"/>
                    </button>
                    <button class="o_cc_activity" title="Source Control"
                            t-att-class="{'active': state.view === 'scm'}"
                            t-on-click="() => this.setView('scm')">
                        <i class="fa fa-code-fork"/>
                        <span t-if="stagedChanges.length" class="o_cc_activity_badge"
                              t-esc="stagedChanges.length"/>
                    </button>
                </nav>

                <!-- side bar -->
                <aside class="o_cc_sidebar d-flex flex-column overflow-hidden">

                    <!-- Chat: conversation list -->
                    <t t-if="state.view === 'chat'">
                        <div class="o_cc_sidebar_head d-flex align-items-center">
                            <span class="flex-grow-1">Conversations</span>
                            <button class="o_cc_icon_btn" title="New conversation"
                                    t-on-click="newConversation">
                                <i class="fa fa-plus"/>
                            </button>
                        </div>
                        <div class="overflow-auto flex-grow-1 o_cc_tree">
                            <t t-foreach="state.conversations" t-as="conv" t-key="conv.id">
                                <button class="o_cc_row"
                                        style="padding-left: 8px"
                                        t-att-class="{'active': state.activeConversationId === conv.id}"
                                        t-on-click="() => this.selectConversation(conv.id)">
                                    <i class="fa fa-comment-o o_cc_twisty"/>
                                    <span class="o_cc_row_label" t-esc="conv.name"/>
                                </button>
                            </t>
                            <div t-if="!state.conversations.length" class="o_cc_hint p-3">
                                No conversations yet. Press <i class="fa fa-plus"/> to start one.
                            </div>
                        </div>
                    </t>

                    <!-- Explorer: module / folder / file tree -->
                    <t t-if="state.view === 'explorer'">
                        <div class="o_cc_sidebar_head d-flex align-items-center">
                            <span class="flex-grow-1">Explorer</span>
                            <button class="o_cc_icon_btn" title="New file in the selected module"
                                    t-att-disabled="!canEdit"
                                    t-on-click="startNewFile">
                                <i class="fa fa-file-o"/>
                            </button>
                            <button class="o_cc_icon_btn" title="New module"
                                    t-att-disabled="!canEdit"
                                    t-on-click="startNewModule">
                                <i class="fa fa-cube"/>
                            </button>
                            <button class="o_cc_icon_btn" title="Refresh"
                                    t-on-click="loadModules">
                                <i class="fa fa-refresh"/>
                            </button>
                        </div>

                        <div class="overflow-auto flex-grow-1 o_cc_tree">
                            <div t-if="state.creating" class="px-2 py-1">
                                <div class="o_cc_hint mb-1" t-if="state.creating.kind === 'file'">
                                    New file in <t t-esc="state.creating.module"/>
                                </div>
                                <div class="o_cc_hint mb-1" t-else="">New module name</div>
                                <input class="o_cc_new_input"
                                       t-ref="newNameInput"
                                       t-att-placeholder="state.creating.kind === 'file' ? 'models/my_model.py' : 'centric_my_module'"
                                       t-model="state.creating.value"
                                       t-on-keydown="onCreateKeydown"
                                       t-on-blur="cancelCreate"/>
                            </div>

                            <div t-if="state.modulesLoading" class="o_cc_hint p-3">
                                <i class="fa fa-spinner fa-spin me-2"/>Reading the repository...
                            </div>

                            <t t-foreach="treeRows" t-as="row" t-key="row.key">
                                <button t-if="row.node.type === 'module'"
                                        class="o_cc_row o_cc_row_module"
                                        t-att-style="indentOf(row.depth)"
                                        t-att-class="{'active': state.activeModule === row.node.name}"
                                        t-on-click="() => this.toggleModule(row.node)">
                                    <i class="o_cc_twisty fa"
                                       t-att-class="row.node.expanded ? 'fa-chevron-down' : 'fa-chevron-right'"/>
                                    <i class="fa fa-cube"/>
                                    <span class="o_cc_row_label" t-esc="row.node.name"/>
                                </button>

                                <button t-elif="row.node.type === 'dir'"
                                        class="o_cc_row"
                                        t-att-style="indentOf(row.depth)"
                                        t-on-click="() => this.toggleDir(row.node)">
                                    <i class="o_cc_twisty fa"
                                       t-att-class="row.node.expanded ? 'fa-chevron-down' : 'fa-chevron-right'"/>
                                    <i class="fa" t-att-class="iconFor(row.node)"/>
                                    <span class="o_cc_row_label" t-esc="row.node.name"/>
                                </button>

                                <button t-else=""
                                        class="o_cc_row"
                                        t-att-style="indentOf(row.depth)"
                                        t-att-class="{'active': state.activeFileKey === fileKey(row.module, row.node.path)}"
                                        t-on-click="() => this.openFile(row.module, row.node.path)">
                                    <span class="o_cc_twisty"/>
                                    <i class="fa" t-att-class="iconFor(row.node)"/>
                                    <span class="o_cc_row_label" t-esc="row.node.name"/>
                                </button>
                            </t>

                            <div t-if="state.modulesLoaded &amp;&amp; !state.modules.length"
                                 class="o_cc_hint p-3">
                                <p class="mb-2">
                                    No modules starting with
                                    <code><t t-esc="state.access.allowed_module_prefix"/></code>
                                    were found on branch
                                    <code><t t-esc="activeBranch"/></code>.
                                </p>
                                <p class="mb-0">
                                    That branch is probably not the one your modules live on.
                                    An administrator can change Default Base Branch in Settings,
                                    then start a new conversation.
                                </p>
                            </div>
                        </div>
                    </t>

                    <!-- Source control: staged changes -->
                    <t t-if="state.view === 'scm'">
                        <div class="o_cc_sidebar_head d-flex align-items-center">
                            <span class="flex-grow-1">Source Control</span>
                        </div>
                        <div class="overflow-auto flex-grow-1 o_cc_tree">
                            <t t-foreach="state.changes" t-as="change" t-key="change.id">
                                <div class="o_cc_row" t-att-title="change.summary">
                                    <i class="o_cc_twisty fa"
                                       t-att-class="change.status === 'committed' ? 'fa-check' : 'fa-pencil'"/>
                                    <span class="o_cc_row_label" t-esc="change.file_path"/>
                                </div>
                            </t>
                            <div t-if="!state.changes.length" class="o_cc_hint p-3">
                                Nothing staged yet. Ask Claude for a change, or edit a file in
                                the Explorer and press Stage.
                            </div>
                        </div>
                    </t>
                </aside>

                <!-- main pane -->
                <main class="flex-grow-1 d-flex flex-column overflow-hidden">

                    <div t-if="!state.conversation"
                         class="flex-grow-1 d-flex align-items-center justify-content-center">
                        <div class="o_cc_empty">
                            <i class="fa fa-comments-o fa-3x mb-3 d-block"/>
                            <div>Create a conversation to start.</div>
                        </div>
                    </div>

                    <t t-else="">
                        <!-- chat -->
                        <t t-if="state.view === 'chat'">
                            <div class="o_cc_chat_scroll flex-grow-1 overflow-auto p-3">
                                <div t-if="!state.messages.length" class="o_cc_welcome">
                                    <div class="o_cc_welcome_mark"><i class="fa fa-cube"/></div>
                                    <h5 class="mb-1">Claude Developer</h5>
                                    <p class="o_cc_hint mb-4">
                                        Ask about an approved module, an error, or a code change.
                                        Answers come from the source on
                                        <code><t t-esc="activeBranch"/></code>.
                                    </p>
                                    <div class="o_cc_suggestions">
                                        <t t-foreach="suggestions" t-as="idea" t-key="idea">
                                            <button class="o_cc_suggestion"
                                                    t-on-click="() => this.useSuggestion(idea)">
                                                <i class="fa fa-angle-right me-2"/><t t-esc="idea"/>
                                            </button>
                                        </t>
                                    </div>
                                </div>
                                <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                                    <div class="o_cc_message mb-3"
                                         t-att-class="msg.role === 'user' ? 'o_cc_message_user' : 'o_cc_message_assistant'">
                                        <div class="o_cc_message_role"
                                             t-esc="msg.role === 'user' ? 'You' : 'Claude'"/>
                                        <div class="o_cc_message_content"><t t-esc="msg.content"/></div>
                                    </div>
                                </t>
                                <t t-foreach="pendingOperations" t-as="op" t-key="op.id">
                                    <div class="o_cc_confirm mb-3">
                                        <div class="o_cc_confirm_head">
                                            <i class="fa me-2" t-att-class="operationIcon(op)"/>
                                            <span class="flex-grow-1" t-esc="op.summary"/>
                                            <span class="o_cc_confirm_tag" t-esc="op.model"/>
                                        </div>
                                        <pre class="o_cc_confirm_body"><t t-esc="op.preview"/></pre>
                                        <div class="o_cc_confirm_actions">
                                            <span class="o_cc_hint flex-grow-1">
                                                Nothing has changed yet.
                                            </span>
                                            <button class="btn btn-sm btn-outline-light"
                                                    t-att-disabled="state.busy"
                                                    t-on-click="() => this.answerOperation(op.id, false)">
                                                No
                                            </button>
                                            <button class="btn btn-sm btn-primary"
                                                    t-att-disabled="state.busy"
                                                    t-on-click="() => this.answerOperation(op.id, true)">
                                                <i class="fa fa-check me-1"/>Yes, do it
                                            </button>
                                        </div>
                                    </div>
                                </t>

                                <div t-if="state.busy" class="o_cc_message mb-3">
                                    <div class="o_cc_message_role">Claude</div>

                                    <div t-if="agentOffline" class="o_cc_offline">
                                        <div class="fw-semibold mb-1">
                                            <i class="fa fa-plug me-2"/>No local agent is connected
                                        </div>
                                        <div class="o_cc_hint mb-2">
                                            Your question is queued and will be answered as soon as
                                            the bridge is running on your machine. Start it, or set
                                            it to start automatically when you log in:
                                        </div>
                                        <pre class="o_cc_offline_cmd">python claude_bridge.py --install</pre>
                                        <button class="btn btn-sm btn-outline-light"
                                                t-on-click="cancelTurn">Cancel the question</button>
                                    </div>

                                    <div t-else="" class="o_cc_hint d-flex align-items-center gap-2">
                                        <i class="fa fa-spinner fa-spin"/>
                                        <span t-if="agentStatusText" t-esc="agentStatusText"/>
                                        <span t-else="">Working with the approved tools...</span>
                                        <button t-if="state.agent.waiting"
                                                class="btn btn-sm btn-link text-danger p-0 ms-2"
                                                t-on-click="cancelTurn">Cancel</button>
                                    </div>
                                </div>
                            </div>

                            <form class="o_cc_composer p-3" t-on-submit="sendMessage">
                                <textarea class="form-control"
                                          rows="3"
                                          placeholder="Ask Claude to inspect or fix an approved custom module..."
                                          t-model="state.messageDraft"
                                          t-on-keydown="onComposerKeydown"
                                          t-att-disabled="state.busy"/>
                                <div class="d-flex align-items-center mt-2 gap-2">
                                    <div class="o_cc_hint flex-grow-1">
                                        <t t-if="canEdit">
                                            Developer Mode is ON. Claude may stage code changes,
                                            but cannot commit them itself.
                                        </t>
                                        <t t-else="">
                                            Read-only chat. Enable Developer Mode to let Claude
                                            stage code changes.
                                        </t>
                                    </div>
                                    <button class="btn btn-primary btn-sm" type="submit"
                                            t-att-disabled="state.busy || !state.messageDraft.trim()">
                                        Send
                                    </button>
                                </div>
                            </form>
                        </t>

                        <!-- editor -->
                        <t t-if="state.view === 'explorer'">
                            <div class="o_cc_tabbar d-flex align-items-stretch"
                                 t-if="state.openFiles.length">
                                <t t-foreach="state.openFiles" t-as="file" t-key="file.key">
                                    <div class="o_cc_tab"
                                         t-att-class="{'active': state.activeFileKey === file.key}"
                                         t-on-click="() => this.selectTab(file.key)">
                                        <i class="fa" t-att-class="iconFor({type: 'file', name: file.path})"/>
                                        <span t-esc="file.path.split('/').pop()"/>
                                        <span t-if="isDirty(file)" class="o_cc_tab_dirty"
                                              title="Unstaged edits"/>
                                        <button class="o_cc_tab_close" title="Close"
                                                t-on-click="(ev) => this.closeTab(file.key, ev)">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </div>
                                </t>
                            </div>

                            <div t-if="!activeFile"
                                 class="flex-grow-1 d-flex align-items-center justify-content-center">
                                <div class="o_cc_empty">
                                    <i class="fa fa-files-o fa-3x mb-3 d-block"/>
                                    <div>Select a file in the Explorer.</div>
                                </div>
                            </div>

                            <t t-else="">
                                <div class="o_cc_breadcrumb d-flex align-items-center gap-2">
                                    <span class="flex-grow-1 text-truncate">
                                        <t t-esc="activeFile.module"/>
                                        <i class="fa fa-angle-right mx-1"/>
                                        <t t-esc="activeFile.path"/>
                                    </span>
                                    <div class="o_cc_editor_actions d-flex gap-2">
                                        <button t-if="canEdit &amp;&amp; !isEditing"
                                                class="btn btn-outline-light"
                                                t-on-click="startEditing">
                                            <i class="fa fa-pencil me-1"/>Edit
                                        </button>
                                        <t t-if="isEditing">
                                            <button class="btn btn-outline-light"
                                                    t-on-click="cancelEditing">Revert</button>
                                            <button class="btn btn-primary"
                                                    t-att-disabled="!isDirty(activeFile)"
                                                    t-on-click="stageActiveFile">
                                                <i class="fa fa-plus me-1"/>Stage
                                            </button>
                                        </t>
                                    </div>
                                </div>

                                <div class="o_cc_editor_surface flex-grow-1 d-flex overflow-hidden">
                                    <div class="o_cc_gutter" t-ref="gutter"><t t-esc="lineNumbers"/></div>
                                    <textarea t-if="isEditing"
                                              class="o_cc_code_textarea"
                                              spellcheck="false"
                                              t-model="state.editorDraft"
                                              t-on-keydown="onEditorKeydown"
                                              t-on-scroll="onCodeScroll"/>
                                    <pre t-else="" class="o_cc_code_pre" t-ref="codePane"
                                         t-on-scroll="onCodeScroll"><t t-out="highlightedCode"/></pre>
                                </div>
                            </t>
                        </t>

                        <!-- source control -->
                        <t t-if="state.view === 'scm'">
                            <div class="o_cc_scroll_panel flex-grow-1 overflow-auto p-3">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">Staged and committed changes</h6>
                                        <div class="o_cc_hint">
                                            Nothing reaches GitHub until an authorised developer clicks Commit.
                                        </div>
                                    </div>
                                    <button t-if="stagedChanges.length &amp;&amp; canEdit"
                                            class="btn btn-primary btn-sm"
                                            t-att-disabled="state.busy"
                                            t-on-click="commitChanges">
                                        <i class="fa fa-check me-1"/>Commit to Review Branch
                                    </button>
                                    <button t-if="state.conversation.commit_sha &amp;&amp; !state.conversation.pull_request_url &amp;&amp; state.access.can_create_pr"
                                            class="btn btn-outline-light btn-sm"
                                            t-att-disabled="state.busy"
                                            t-on-click="createPullRequest">
                                        Create Pull Request
                                    </button>
                                    <button t-if="state.conversation.pull_request_url"
                                            class="btn btn-outline-light btn-sm"
                                            t-on-click="openPullRequest">
                                        Open Pull Request
                                    </button>
                                </div>

                                <div t-if="state.conversation.review_branch"
                                     class="o_cc_hint mb-3">
                                    Review branch: <code><t t-esc="state.conversation.review_branch"/></code>
                                    <t t-if="state.conversation.commit_sha">
                                        <span class="ms-3">Commit:
                                            <code><t t-esc="state.conversation.commit_sha.slice(0, 12)"/></code>
                                        </span>
                                    </t>
                                </div>

                                <div t-if="!state.changes.length" class="o_cc_empty py-5">
                                    No code changes have been staged in this conversation.
                                </div>

                                <div t-foreach="state.changes" t-as="change" t-key="change.id"
                                     class="o_cc_change_card mb-3">
                                    <div class="o_cc_change_head d-flex align-items-center gap-2 p-2">
                                        <div class="flex-grow-1">
                                            <div class="fw-bold">
                                                <t t-esc="change.module_name"/>/<t t-esc="change.file_path"/>
                                            </div>
                                            <div class="o_cc_hint" t-esc="change.summary"/>
                                        </div>
                                        <span class="badge"
                                              t-att-class="change.status === 'staged' ? 'text-bg-warning' : (change.status === 'committed' ? 'text-bg-success' : 'text-bg-secondary')"
                                              t-esc="change.status"/>
                                        <button t-if="change.status === 'staged'"
                                                class="btn btn-sm btn-outline-danger"
                                                t-on-click="() => this.discardChange(change.id)">
                                            Discard
                                        </button>
                                    </div>
                                    <pre class="o_cc_diff"><t t-out="diffMarkup(change)"/></pre>
                                </div>
                            </div>
                        </t>
                    </t>
                </main>
            </div>

            <!-- status bar -->
            <div class="o_cc_statusbar d-flex align-items-center"
                 t-if="!state.loading &amp;&amp; state.access.enabled">
                <button class="o_cc_status_item" t-if="state.conversation"
                        t-on-click="() => this.setView('scm')">
                    <i class="fa fa-code-fork"/><t t-esc="activeBranch"/>
                </button>
                <button class="o_cc_status_item" t-if="state.conversation"
                        t-on-click="() => this.setView('scm')">
                    <i class="fa fa-pencil"/><t t-esc="stagedChanges.length"/> staged
                </button>
                <span class="o_cc_status_item" t-if="state.busy">
                    <i class="fa fa-circle-o-notch fa-spin"/>
                    <t t-esc="agentStatusText || 'Working...'"/>
                </span>
                <span class="ms-auto"/>
                <span class="o_cc_status_item" t-if="activeFile">
                    <t t-esc="lineCount"/> lines
                </span>
                <span class="o_cc_status_item" t-if="activeFile">
                    <t t-esc="activeLanguage"/>
                </span>
            </div>
        </div>
    </t>

</templates>
