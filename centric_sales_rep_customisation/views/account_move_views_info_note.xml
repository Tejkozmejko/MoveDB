<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_centric_info_note" model="ir.ui.view">
        <field name="name">account.move.form.centric.info.note</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Invoice header, shown on customer invoices/refunds. Carried over
                 from the sales order but editable, so a note can still be added
                 to an invoice raised on its own. -->
            <field name="centric_customer_po" position="after">
                <field name="centric_info_note"
                       placeholder="Note printed on the invoice, e.g. VAT number"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </field>
        </field>
    </record>
</odoo>
