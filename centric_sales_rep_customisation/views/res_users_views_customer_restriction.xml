<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_centric_sales_customer" model="ir.ui.view">
        <field name="name">res.users.form.centric.sales.customer.restriction</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/group[1]" position="after">
                <group string="Sales Restriction" name="centric_sales_restriction" invisible="share">
                    <field name="centric_allowed_customer_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="No restriction — all customers allowed"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
