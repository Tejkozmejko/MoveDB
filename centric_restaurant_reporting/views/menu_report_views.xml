<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_menu_report_pivot" model="ir.ui.view">
        <field name="name">centric.restaurant.menu.report.pivot</field>
        <field name="model">centric.restaurant.menu.report</field>
        <field name="arch" type="xml">
            <pivot string="Menu Performance" sample="1">
                <field name="product_id" type="row"/>
                <field name="qty" type="measure"/>
                <field name="revenue" type="measure"/>
                <field name="cost" type="measure"/>
                <field name="margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_menu_report_graph" model="ir.ui.view">
        <field name="name">centric.restaurant.menu.report.graph</field>
        <field name="model">centric.restaurant.menu.report</field>
        <field name="arch" type="xml">
            <graph string="Menu Performance" type="bar" sample="1">
                <field name="product_id"/>
                <field name="margin" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_menu_report_list" model="ir.ui.view">
        <field name="name">centric.restaurant.menu.report.list</field>
        <field name="model">centric.restaurant.menu.report</field>
        <field name="arch" type="xml">
            <list string="Menu Performance" create="false">
                <field name="date"/>
                <field name="order_id"/>
                <field name="config_id"/>
                <field name="product_id"/>
                <field name="categ_id" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="qty" sum="Quantity"/>
                <field name="revenue" sum="Revenue"/>
                <field name="cost" sum="Cost"/>
                <field name="margin" sum="Margin"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_menu_report_search" model="ir.ui.view">
        <field name="name">centric.restaurant.menu.report.search</field>
        <field name="model">centric.restaurant.menu.report</field>
        <field name="arch" type="xml">
            <search string="Menu Performance">
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="config_id"/>
                <field name="user_id"/>
                <filter name="filter_today" string="Today" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_week" string="This Week" domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_month" string="This Month" domain="[('date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_loss_making" string="Loss Making" domain="[('margin', '&lt;', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Dish" context="{'group_by': 'product_id'}"/>
                    <filter name="group_categ" string="Product Category" context="{'group_by': 'categ_id'}"/>
                    <filter name="group_config" string="Point of Sale" context="{'group_by': 'config_id'}"/>
                    <filter name="group_session" string="Session" context="{'group_by': 'session_id'}"/>
                    <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}"/>
                    <filter name="group_date" string="Order Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_menu_report" model="ir.actions.act_window">
        <field name="name">Menu Performance</field>
        <field name="res_model">centric.restaurant.menu.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_menu_report_search"/>
        <field name="context">{'search_default_group_product': 1, 'search_default_filter_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No POS sales to report yet</p>
            <p>
                Quantity sold, revenue, cost and margin for every dish. Cost comes
                from the recipe roll-up, so this is where menu engineering happens.
            </p>
        </field>
    </record>

</odoo>
