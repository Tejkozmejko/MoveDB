<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_claude_workspace" model="ir.actions.client">
        <field name="name">Claude Developer</field>
        <field name="tag">centric_claude_integration.developer_workspace</field>
    </record>

    <!-- The Apps list finds static/description/icon.png by itself; the
         app-switcher tile only ever reads web_icon, which has no fallback.
         Without this line the tile is the default placeholder however many
         icons sit in static/description. -->
    <menuitem id="menu_claude_root"
              name="Claude"
              sequence="75"
              web_icon="centric_claude_integration,static/description/icon.png"
              groups="centric_claude_integration.group_claude_user"/>

    <menuitem id="menu_claude_workspace"
              name="Developer Workspace"
              parent="menu_claude_root"
              action="action_claude_workspace"
              sequence="10"
              groups="centric_claude_integration.group_claude_user"/>

    <menuitem id="menu_claude_turns"
              name="Agent Queue"
              parent="menu_claude_root"
              action="action_claude_turns"
              sequence="80"
              groups="centric_claude_integration.group_claude_admin"/>

    <menuitem id="menu_claude_audit_logs"
              name="Audit Logs"
              parent="menu_claude_root"
              action="action_claude_audit_logs"
              sequence="90"
              groups="centric_claude_integration.group_claude_admin"/>

</odoo>
